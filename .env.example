# All optional. The pipeline runs keyless against public endpoints by default.
# Comma-separated private RPC endpoints per chain slug (upper-cased), used before the public list.
# RPC_URLS_BNB=https://your-bsc-node.example
# NEXT_PUBLIC_SITE_URL=https://agentic-ecosystem-board.vercel.app
# The Graph API key (free at https://thegraph.com/studio/apikeys/). Makes the first backfill take minutes instead of hours.
# GRAPH_API_KEY=
