{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["bun-types"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["pipeline/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
